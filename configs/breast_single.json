{
  "mode": "single_task",
  "task": "BrEaST",
  "data_root": "$DATA_ROOT",
  "manifest": "$MANIFEST",
  "snapshot": "$SNAPSHOT_DIR",
  "output": "$RUN_OUTPUT",
  "seed": 0,
  "batch_size": 32,
  "updates": 1000,
  "backbone_lr": 1e-05,
  "head_lr": 0.0001,
  "weight_decay": 0.01,
  "beta_vl": 1.0,
  "bf16": true,
  "prompt_template": "a breast ultrasound image showing {label}.",
  "eval_every": 200,
  "concept_schema": "$CONCEPT_SCHEMA",
  "alpha_concept": 1.0,
  "overfit_per_class": 12
}
