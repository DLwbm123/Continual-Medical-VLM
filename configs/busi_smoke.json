{
  "mode": "smoke_overfit",
  "task": "BUSI",
  "data_root": "$DATA_ROOT",
  "manifest": "$MANIFEST",
  "snapshot": "$SNAPSHOT_DIR",
  "output": "$RUN_OUTPUT",
  "seed": 0,
  "batch_size": 32,
  "updates": 100,
  "overfit_per_class": 8,
  "backbone_lr": 0.00001,
  "head_lr": 0.0001,
  "weight_decay": 0.01,
  "beta_vl": 1.0,
  "bf16": true,
  "prompt_template": "a breast ultrasound image showing {label}.",
  "eval_every": 200
}
